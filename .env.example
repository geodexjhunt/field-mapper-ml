# Embedding Backend
# Options: 'local', 'google', 'cohere'
EMBEDDING_BACKEND=local

# Google API Key (required if EMBEDDING_BACKEND=google)
GOOGLE_API_KEY=your_google_api_key_here

# Cohere API Key (required if EMBEDDING_BACKEND=cohere)
COHERE_API_KEY=your_cohere_api_key_here

# Confidence thresholds
MIN_CONFIDENCE_LEGACY=0.75
MIN_CONFIDENCE_DIRECT=0.70

# Number of top matches to return per source field
TOP_N_MATCHES=3
